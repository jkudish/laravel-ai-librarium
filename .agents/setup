#!/usr/bin/env bash

set -euo pipefail

repository_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${repository_root}"

step() {
    printf '\n==> %s\n' "$1"
}

if [[ ${EUID} -eq 0 ]]; then
    SUDO=()
else
    SUDO=(sudo)
fi

php_ready=false
if command -v php >/dev/null 2>&1 \
    && php -r 'exit(PHP_VERSION_ID >= 80500 && PHP_VERSION_ID < 80600 ? 0 : 1);' \
    && php -r 'foreach (["curl", "dom", "fileinfo", "mbstring", "xml", "xmlwriter", "zip"] as $extension) { if (! extension_loaded($extension)) { exit(1); } }'; then
    php_ready=true
fi

if [[ ${php_ready} != true ]]; then
    step 'Installing PHP 8.5 and required extensions'
    export DEBIAN_FRONTEND=noninteractive
    "${SUDO[@]}" apt-get update
    "${SUDO[@]}" apt-get install -y --no-install-recommends ca-certificates curl lsb-release

    if ! apt-cache show php8.5-cli >/dev/null 2>&1; then
        curl -fsSL https://packages.sury.org/php/apt.gpg -o /tmp/debsuryorg-archive-keyring.gpg
        "${SUDO[@]}" install -m 0644 /tmp/debsuryorg-archive-keyring.gpg /usr/share/keyrings/debsuryorg-archive-keyring.gpg
        rm -f /tmp/debsuryorg-archive-keyring.gpg
        printf 'deb [signed-by=/usr/share/keyrings/debsuryorg-archive-keyring.gpg] https://packages.sury.org/php/ %s main\n' "$(lsb_release -sc)" \
            | "${SUDO[@]}" tee /etc/apt/sources.list.d/php.list >/dev/null
        "${SUDO[@]}" apt-get update
    fi

    "${SUDO[@]}" apt-get install -y --no-install-recommends \
        php8.5-cli \
        php8.5-curl \
        php8.5-mbstring \
        php8.5-xml \
        php8.5-zip \
        unzip
    "${SUDO[@]}" update-alternatives --set php /usr/bin/php8.5
fi

composer_ready=false
if command -v composer >/dev/null 2>&1 \
    && composer --version --no-ansi 2>/dev/null | grep -Eq '^Composer version 2\.'; then
    composer_ready=true
fi

if [[ ${composer_ready} != true ]]; then
    step 'Installing Composer 2'
    installer=/tmp/composer-setup.php
    expected_checksum="$(curl -fsSL https://composer.github.io/installer.sig)"
    curl -fsSL https://getcomposer.org/installer -o "${installer}"
    actual_checksum="$(php -r "echo hash_file('sha384', '${installer}');")"

    if [[ ${actual_checksum} != "${expected_checksum}" ]]; then
        rm -f "${installer}"
        echo 'Composer installer checksum verification failed.' >&2
        exit 1
    fi

    "${SUDO[@]}" php "${installer}" --2 --install-dir=/usr/local/bin --filename=composer --quiet
    rm -f "${installer}"
    hash -r
fi

step 'Resolving Composer dependencies'
# This library intentionally does not commit composer.lock, so update is the
# reproducible setup operation: it always reconciles vendor with composer.json.
composer update --no-interaction --prefer-dist --no-progress
sha256sum composer.json | cut -d ' ' -f 1 > vendor/.librarium-composer-json.sha256

step 'Verifying PHP and dependency requirements'
php -v | head -n 1
composer --version --no-ansi
composer check-platform-reqs

printf '\nOrb setup complete.\n'
