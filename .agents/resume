#!/usr/bin/env bash

set -euo pipefail

repository_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${repository_root}"

php -r 'if (PHP_VERSION_ID < 80500 || PHP_VERSION_ID >= 80600) { exit(1); } foreach (["curl", "dom", "fileinfo", "mbstring", "xml", "xmlwriter", "zip"] as $extension) { if (! extension_loaded($extension)) { exit(1); } }'
command -v composer >/dev/null
composer --version --no-ansi 2>/dev/null | grep -Eq '^Composer version 2\.'

composer_hash="$(sha256sum composer.json | cut -d ' ' -f 1)"
stored_composer_hash="$(cat vendor/.librarium-composer-json.sha256 2>/dev/null || true)"

if [[ ! -f vendor/autoload.php || ${composer_hash} != "${stored_composer_hash}" ]]; then
    echo 'Refreshing orb Composer dependencies.'
    composer update --no-interaction --prefer-dist --no-progress
    printf '%s\n' "${composer_hash}" > vendor/.librarium-composer-json.sha256
fi

composer check-platform-reqs --no-ansi >/dev/null

echo 'Orb PHP and Composer dependencies are ready.'
