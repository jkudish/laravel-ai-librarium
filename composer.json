{
    "name": "jkudish/laravel-ai-librarium",
    "description": "A Laravel-native research query abstraction built on the Laravel AI SDK.",
    "type": "library",
    "keywords": [
        "ai",
        "laravel",
        "research"
    ],
    "homepage": "https://github.com/jkudish/laravel-ai-librarium",
    "license": "MIT",
    "authors": [
        {
            "name": "Joey Kudish",
            "email": "joachim.kudish@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/cache": "^13.30",
        "illuminate/console": "^13.30",
        "illuminate/contracts": "^13.30",
        "illuminate/database": "^13.30",
        "illuminate/encryption": "^13.30",
        "illuminate/filesystem": "^13.30",
        "illuminate/http": "^13.30",
        "illuminate/routing": "^13.30",
        "illuminate/support": "^13.30",
        "illuminate/validation": "^13.30",
        "jkudish/laravel-ai-pricing": "^0.3.1",
        "jkudish/librarium-spec": "dev-spec-15c8a306",
        "laravel/ai": "^1.0.1",
        "laravel/prompts": "^0.3.15",
        "league/commonmark": "^2.10.2",
        "opis/json-schema": "^2.6",
        "standard-webhooks/standard-webhooks": "^1.0"
    },
    "repositories": [
        {
            "type": "package",
            "package": {
                "name": "jkudish/librarium-spec",
                "version": "dev-spec-15c8a306",
                "type": "library",
                "license": "MIT",
                "source": {
                    "type": "git",
                    "url": "https://github.com/jkudish/librarium-spec.git",
                    "reference": "15c8a30673b43b006944623be2ddf99f216b846c"
                },
                "dist": {
                    "type": "zip",
                    "url": "https://api.github.com/repos/jkudish/librarium-spec/zipball/15c8a30673b43b006944623be2ddf99f216b846c",
                    "reference": "15c8a30673b43b006944623be2ddf99f216b846c"
                }
            }
        }
    ],
    "require-dev": {
        "laravel/pint": "^1.32.1",
        "larastan/larastan": "^3.13",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.4.1 || ^5.3.1",
        "pestphp/pest-plugin-arch": "^4.0 || ^5.0",
        "pestphp/pest-plugin-laravel": "^4.1 || ^5.0.1",
        "phpstan/extension-installer": "^1.4.3"
    },
    "autoload": {
        "psr-4": {
            "Jkudish\\LaravelAiLibrarium\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jkudish\\LaravelAiLibrarium\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "test": "vendor/bin/pest tests/ArchTest.php tests/Feature tests/Unit",
        "test:conformance": "vendor/bin/pest tests/Feature/SharedFixturesTest.php tests/Feature/RunStoreTest.php",
        "test:live:gemini": [
            "@php -r \"if (getenv('LIBRARIUM_LIVE_TESTS') !== '1') { fwrite(STDERR, 'LIBRARIUM_LIVE_TESTS=1 is required to opt in to live provider tests.'.PHP_EOL); exit(1); }\"",
            "@php -r \"if (! is_string(getenv('GEMINI_API_KEY')) || trim((string) getenv('GEMINI_API_KEY')) === '') { fwrite(STDERR, 'GEMINI_API_KEY is required for the live Gemini canary.'.PHP_EOL); exit(1); }\"",
            "vendor/bin/pest tests/Live/LaravelAiProfilesLiveTest.php --filter='Gemini grounded' --fail-on-skipped"
        ],
        "test:live:openai-research": [
            "@php -r \"if (getenv('LIBRARIUM_LIVE_TESTS') !== '1') { fwrite(STDERR, 'LIBRARIUM_LIVE_TESTS=1 is required to opt in to live provider tests.'.PHP_EOL); exit(1); }\"",
            "@php -r \"if (! is_string(getenv('OPENAI_API_KEY')) || trim((string) getenv('OPENAI_API_KEY')) === '') { fwrite(STDERR, 'OPENAI_API_KEY is required for the live OpenAI research canary.'.PHP_EOL); exit(1); }\"",
            "vendor/bin/pest tests/Live/OpenAiResearchDriverLiveTest.php --fail-on-skipped"
        ],
        "test:live:searchapi": [
            "@php -r \"if (getenv('LIBRARIUM_LIVE_TESTS') !== '1') { fwrite(STDERR, 'LIBRARIUM_LIVE_TESTS=1 is required to opt in to live provider tests.'.PHP_EOL); exit(1); }\"",
            "@php -r \"if (! is_string(getenv('SEARCHAPI_KEY')) || trim((string) getenv('SEARCHAPI_KEY')) === '') { fwrite(STDERR, 'SEARCHAPI_KEY is required for the live SearchAPI canary.'.PHP_EOL); exit(1); }\"",
            "vendor/bin/pest tests/Live/SearchApiProfilesLiveTest.php --fail-on-skipped"
        ],
        "test:live:sdk": [
            "@php -r \"if (getenv('LIBRARIUM_LIVE_TESTS') !== '1') { fwrite(STDERR, 'LIBRARIUM_LIVE_TESTS=1 is required to opt in to live provider tests.'.PHP_EOL); exit(1); }\"",
            "@php -r \"foreach (['GEMINI_API_KEY', 'OPENROUTER_API_KEY', 'ANTHROPIC_API_KEY', 'OPENAI_API_KEY'] as \\$key) { if (! is_string(getenv(\\$key)) || trim((string) getenv(\\$key)) === '') { fwrite(STDERR, \\$key.' is required for the live SDK canaries.'.PHP_EOL); exit(1); } }\"",
            "vendor/bin/pest tests/Live/LaravelAiProfilesLiveTest.php --fail-on-skipped"
        ],
        "format": "vendor/bin/pint --format agent",
        "format:check": "vendor/bin/pint --test",
        "compatibility:check": [
            "@composer validate --strict",
            "@composer check-platform-reqs",
            "@composer test",
            "@composer analyse",
            "@composer format:check"
        ],
        "pr:check": "@php tools/pr-check.php",
        "pr:signoff": "@php tools/pr-signoff.php",
        "release:check": "@php tools/release-check.php",
        "check": [
            "@composer format:check",
            "@composer analyse",
            "@composer test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Jkudish\\LaravelAiLibrarium\\LaravelAiLibrariumServiceProvider"
            ]
        }
    },
    "prefer-stable": true
}
